# Kinder Web settings — copy to kinder.env (git-ignored) and fill in.
#   cp kinder.env.example kinder.env
# kinder.env is loaded once by app/config.py and overrides variables inherited from the shell.

# ---- Application -----------------------------------------------------------
DEBUG=False
HOST=127.0.0.1
PORT=5000
# Public base URL used for absolute links (OAuth redirect_uri) and the Host check.
APP_BASE_URL=https://kinder.example.org

# REQUIRED. Long random value; the app refuses to start without it.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Max request body in MB (uploads). Default 64.
MAX_CONTENT_LENGTH_MB=64
# Shared rate-limit store (SQLite). Default: app/data/rate_limit.sqlite3
# RATE_LIMIT_DB=

# ---- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Admin -----------------------------------------------------------------
# Always allowed to register / treated as the site owner.
ADMIN_EMAIL=
# Local /admin-login is disabled unless ALL THREE are set, and ADMIN_LOCAL_EMAIL
# has a row in auth.users (its role / is_admin come from that row).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_LOCAL_EMAIL=

# ---- PostgreSQL ------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=

# ---- Email (notifications) -------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# ---- TNS bot ---------------------------------------------------------------
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=

# ---- Slack (Daily Trigger / GCN) -------------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID_CONTROL_ROOM=
SLACK_CHANNEL_ID_GCN=

# ---- GCN alerts ------------------------------------------------------------
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=

# ---- DETECT ----------------------------------------------------------------
# Set to 0 when a stand-alone DETECT daemon already serves this database.
DETECT_IN_WEB=1
# DETECT_DATA_DIR=            # default: app/vendor/DETECT/data
# DETECT_PAGE_CACHE_MAX_SIZE=8
# DETECT_PAGE_CACHE_TTL_SEC=600
# DETECT_PAGE_PREWARM_DAYS=3
# DETECT_LC_CACHE_MAX_SIZE=300
# DETECT_TRACKER_CACHE_TTL=300
# VIZIER_TIMEOUT_SEC=8

# ---- Logging ---------------------------------------------------------------
ACCESS_LOG_ENABLED=0
# LOG_MAX_FILE_BYTES=15728640
# LOG_MAX_LINE_CHARS=1600
