# Kinder Web settings — copy to kinder.env (git-ignored) and fill in.
#   cp kinder.env.example kinder.env
# kinder.env is loaded once by app/config.py and overrides variables inherited from the shell.

# ---- Application -----------------------------------------------------------
DEBUG=False
HOST=127.0.0.1
PORT=5000
# Public base URL used for absolute links (OAuth redirect_uri) and the Host check.
APP_BASE_URL=https://kinder.example.org

# REQUIRED. Long random value; the app refuses to start without it.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session cookie only over HTTPS. Default: true (false when DEBUG=True so the local
# http:// dev server works). Keep true in production behind the HTTPS proxy.
SESSION_COOKIE_SECURE=true

# Max request body in MB (uploads). Default 64.
MAX_CONTENT_LENGTH_MB=64
# Shared rate-limit store (SQLite). Default: app/data/rate_limit.sqlite3
# RATE_LIMIT_DB=

# ---- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Admin -----------------------------------------------------------------
# Always allowed to register / treated as the site owner.
ADMIN_EMAIL=
# Emergency local admin login (Direct login with ADMIN_USERNAME when no DB account
# has that username). Disabled unless ALL THREE are set, and ADMIN_LOCAL_EMAIL has
# a row in auth.users (its role / is_admin come from that row). Leave these EMPTY in
# production unless you really need a break-glass login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_LOCAL_EMAIL=

# ---- PostgreSQL ------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
# Use a dedicated least-privilege role (owner of / granted on the Kinder schemas),
# NOT the postgres superuser. The startup migration needs ALTER/CREATE INDEX on
# auth.* and transient.*; everything else only needs SELECT/INSERT/UPDATE/DELETE.
PG_USER=kinder_web
PG_PASSWORD=

# ---- Email (notifications) -------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# ---- TNS bot ---------------------------------------------------------------
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=

# ---- Slack (Daily Trigger / lab bots) --------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID_CONTROL_ROOM=     # Daily Trigger; Einstein Probe alerts during the Lulin night
SLACK_CHANNEL_ID_GCN=              # GCN circulars
SLACK_CHANNEL_ID_ToO=              # Einstein Probe alerts during the Lulin day
SLACK_CHANNEL_ID_EP_COPY=          # optional: every Einstein Probe alert also here
SLACK_CHANNEL_ID_ALERT=            # TNS AstroNotes

# ---- Lab bots (Admin › Bots, app/services/bots) ----------------------------
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=
# EP_EMAIL_TO=kinder@astro.ncu.edu.tw,amar@astro.ncu.edu.tw
# BOTS_DISABLED=gcn,astronote      # switch single bots off (gcn, astronote, obs_log, reduction)
# OBS_RAW_DIR=                     # default: <reduction folder>/RAW_IMG_Sync/home/janet/lulin_data
# REDUCTION_PIPELINE_DIR=          # default: parent of the calibrated science folder
# REDUCTION_PYTHON=                # Python of the "Lulin" conda env (default: looked for under the folder owner's conda)
# REDUCTION_HOUR_UTC=              # run the reduction daily at this hour; unset = only by hand (greatlab's cron already runs it)
# REDUCTION_SKIP_SYNC=1            # skip the download steps (this user has no ssh key for the raw-data host)
# REDUCTION_STEP_TIMEOUT=10800
# NAS backup bot: moves old raw nights / masters / calibrated targets of the reduction folder to the lab NAS (SMB)
# NAS_IP=100.77.208.119
# NAS_USER=
# NAS_PWD=
# NAS_PATH=great_data/Auto_Backup   # share/folder (or smb://<ip>/great_data/Auto_Backup)
# NAS_ARCHIVE_INTERVAL_MIN=60
# NAS_ARCHIVE_MINUTES=20            # copying time per run; the rest moves next run
# NAS_ARCHIVE_DRY_RUN=1             # only log what would move
# ASTROMETRY_CONFIG=              # astrometry.cfg for solve-field (Pipeline astrometry); default: solve-field's own

# ---- Lab › Calendar (app/services/lab_calendar.py) -------------------------
# LULIN_CALENDAR_ICS=              # iCal of the Lulin LOT schedule; default: the Lulin TAC public Google calendar
# SLACK_CHANNEL_ID_TRIGGER_DUTY=C06BT4DALM6   # Fridays: "nobody on Trigger duty the week after next" (needs SLACK_BOT_TOKEN)

# ---- Web Push (Settings › Push notifications, Admin › Push) ----------------
# Make the pair once with `.venv/bin/python scripts/gen_vapid_keys.py`; every server that sends uses the same pair
# (a new pair means every member has to turn push on again).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kinder@astro.ncu.edu.tw

# ---- DETECT ----------------------------------------------------------------
# Set to 0 when a stand-alone DETECT daemon already serves this database.
DETECT_IN_WEB=1
# DETECT_DATA_DIR=            # default: app/vendor/DETECT/data
# DETECT_PAGE_CACHE_MAX_SIZE=8
# DETECT_PAGE_CACHE_TTL_SEC=600
# DETECT_PAGE_PREWARM_DAYS=3
# DETECT_LC_CACHE_MAX_SIZE=300
# DETECT_TRACKER_CACHE_TTL=300
# VIZIER_TIMEOUT_SEC=8

# ---- Pipeline (AutoPhOT) ---------------------------------------------------
# AutoPhOT is always app/vendor/autophot (scripts/sync_autophot.sh) with its own Python
# (scripts/pipeline/setup_autophot.sh). Only these folders differ per server:
# AUTOPHOT_RUNS=/Users/alex-lee/autophot-runs           # workspaces; default app/data/autophot-runs
# CALIBRATED_SCIENCE_DIR=/Users/greatlab/reduction_pipeline/Calibrated_Science   # read only

# ---- Logging ---------------------------------------------------------------
ACCESS_LOG_ENABLED=0
# LOG_MAX_FILE_BYTES=15728640
# LOG_MAX_LINE_CHARS=1600
