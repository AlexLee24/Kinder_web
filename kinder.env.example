# Copy to kinder.env and fill in. Every key the app reads is listed here; the
# "optional" ones have defaults. See docs/FEATURES.md §7 for who uses what.

# ---- Flask -------------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=True                       # True: dev server, background jobs disabled, small DB pool
HOST=127.0.0.1
PORT=8000
APP_BASE_URL=https://kinder.astro.ncu.edu.tw   # public URL: Host whitelist + OAuth redirect

# ---- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=                     # this Google account becomes admin on first login

# ---- Local admin login (Direct Access on /login) --------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_LOCAL_EMAIL=

# ---- Email (DB alerts, invitations) -------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# ---- TNS bot -----------------------------------------------------------------
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=

# ---- PostgreSQL (database name is fixed to "Kinder") ----------------------------
PG_HOST=
PG_PORT=5432
PG_DATABASE=Kinder
PG_USER=
PG_PASSWORD=

# ---- Photometry sources (QUB ATLAS / Pan-STARRS, via Playwright) ------------------
ATLAS_USER=
ATLAS_PASS=
PANSTARRS_USER=
PANSTARRS_PASS=

# ---- Slack -------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID_CONTROL_ROOM=   # Daily Trigger target (production)
SLACK_CHANNEL_ID_test=           # Daily Trigger target when DEBUG=True
SLACK_CHANNEL_ID_ToO=            # GCN listener (currently disabled)
SLACK_CHANNEL_ID_GCN=

# ---- GCN Kafka (listener currently disabled) ---------------------------------------
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=

# ---- Optional tuning (defaults shown) ----------------------------------------------
#ACCESS_LOG_ENABLED=0
#LOG_MAX_FILE_BYTES=15728640
#LOG_MAX_LINE_CHARS=1600
#DETECT_IN_WEB=1                 # 0 disables DETECT runs inside the web app
#DETECT_DATA_DIR=app/vendor/DETECT/data
#DETECT_PAGE_CACHE_TTL_SEC=600
#DETECT_PAGE_CACHE_MAX_SIZE=8
#DETECT_PAGE_PREWARM_DAYS=3
#DETECT_LC_CACHE_MAX_SIZE=300
#DETECT_TRACKER_CACHE_TTL=300
#VIZIER_TIMEOUT_SEC=8
